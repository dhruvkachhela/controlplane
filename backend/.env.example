# ControlPlane.ai - Environment Variables Template
# Copy this file to .env and provide your actual secrets.
# NEVER commit the actual .env file with real credentials.

# NVIDIA NIM / Laguna 2.1 XS SLM API Configuration
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=poolside/laguna-xs-2.1

# System and Guardrail Configurations
LOG_LEVEL=INFO
RISK_THRESHOLD=0.7
MAX_RETRIES=3
