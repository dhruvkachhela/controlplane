# ControlPlane.ai - Environment Variables Template
# Copy this file to .env and provide your actual secrets.
# NEVER commit the actual .env file with real credentials.

# NVIDIA NIM / Llama 3.1 8B API Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# System and Guardrail Configurations
LOG_LEVEL=INFO
RISK_THRESHOLD=0.7
MAX_RETRIES=3
